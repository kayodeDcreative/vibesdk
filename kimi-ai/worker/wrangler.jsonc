/**
 * Kimi AI Extension - Cloudflare Workers Configuration
 * Standalone worker for AI code generation and analysis operations
 */
{
  "name": "kimi-ai-worker",
  "main": "dist/index.js",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],

  "build": {
    "command": "npm run build",
    "cwd": "./"
  },

  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "kimi_ai_auth",
      "database_id": "b1c55989-f50a-410b-ae2f-909e0ba89acd"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info",
    "API_TIMEOUT": "60000"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
