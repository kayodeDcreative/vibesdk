{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"ignoreDeprecations": "5.0",
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"types": [
			"@cloudflare/workers-types/2023-07-01",
			"vite/client",
			"jest"
		],
		"lib": ["ES2023"]
	},
	"include": [
		"worker-configuration.d.ts",
		"shared/**/*",
		"worker/**/*"
	],
	"exclude": [
		"**/__tests__/**/*",
		"**/*.test.ts"
	]
}
